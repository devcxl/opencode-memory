{
  "name": "opencode-memory",
  "version": "1.2.0",
  "description": "Monorepo for the opencode-memory plugin, its Cloudflare Workers backend and web dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @devcxl/opencode-memory build",
    "build:web": "pnpm --filter @devcxl/opencode-memory-web build",
    "dev": "pnpm --filter @devcxl/opencode-memory dev",
    "dev:api": "pnpm --filter @devcxl/opencode-memory-api dev",
    "deploy:api": "pnpm --filter @devcxl/opencode-memory-api deploy",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"apps/plugin/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/plugin/src/**/*.ts\"",
    "prepare": "husky"
  },
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.8.1"
  }
}
