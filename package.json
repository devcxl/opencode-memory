{
  "name": "@devcxl/opencode-memory",
  "version": "1.2.0",
  "description": "Simple markdown-based memory plugin for OpenCode — supports local and Cloudflare Workers remote modes",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && cp src/instructions/*.md dist/instructions/",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "typecheck:all": "pnpm -r run typecheck",
    "dev:worker": "pnpm --filter @cfmem/api dev",
    "build:web": "pnpm --filter @cfmem/web build",
    "deploy:worker": "pnpm --filter @cfmem/api deploy"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "markdown"
  ],
  "author": "devcxl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devcxl/opencode-memory.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@opencode-ai/plugin": "^1.2.6",
    "jose": "^5.10.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.0.0-next.4",
    "vectra": "^0.12.3"
  },
  "overrides": {
    "onnxruntime-node": "1.23.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^22.19.11",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "opencode": {
    "type": "plugin"
  },
  "files": [
    "dist"
  ]
}
