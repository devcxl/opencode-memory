{
  "name": "opencode-memory",
  "version": "2.0.0-rc.1",
  "description": "Local-only Markdown memory plugin for OpenCode V2",
  "private": true,
  "packageManager": "pnpm@11.28.4",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @devcxl/opencode-memory build",
    "dev": "pnpm --filter @devcxl/opencode-memory dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"apps/plugin/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/plugin/src/**/*.ts\"",
    "prepare": "husky"
  },
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.8.1"
  }
}
