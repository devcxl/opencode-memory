{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@devcxl/opencode-memory-shared": [
        "../../packages/shared/src"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
