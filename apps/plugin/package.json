{
  "name": "@devcxl/cabbage-memory",
  "version": "2.0.0",
  "description": "Remote memory plugin for OpenCode — backed by a Cloudflare Workers memory service (D1 + Vectorize)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@opencode-ai/plugin && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "cloudflare"
  ],
  "author": "devcxl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devcxl/opencode-memory.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.6"
  },
  "devDependencies": {
    "@devcxl/cabbage-memory-shared": "workspace:*",
    "@types/bun": "^1.3.8",
    "@types/node": "^22.19.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "opencode": {
    "type": "plugin"
  },
  "files": [
    "dist"
  ]
}
