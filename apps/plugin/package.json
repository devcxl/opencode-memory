{
  "name": "@devcxl/opencode-memory",
  "version": "2.0.0-rc.1",
  "description": "Markdown-based memory plugin for OpenCode V2 (local mode)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && cp src/instructions/*.md dist/instructions/",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "markdown"
  ],
  "author": "devcxl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devcxl/opencode-memory.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.2",
    "vectra": "^0.15.0"
  },
  "overrides": {
    "onnxruntime-node": "1.23.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
